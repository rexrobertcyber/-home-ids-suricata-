alert tcp any any -> $HOME_NET 22 (msg:"SSH Brute Force Attempt"; flow:to_server,established; threshold:type threshold,track by_src,count 5,seconds 60; classtype:attempted-admin; sid:9000001; rev:1;)
alert icmp any any -> $HOME_NET any (msg:"ICMP Ping Scan Detected"; itype:8; threshold:type threshold,track by_src,count 5,seconds 2; classtype:network-scan; sid:9000002; rev:1;)
alert tcp any any -> $HOME_NET any (msg:"TCP Port Scan Detected"; flags:S; threshold:type threshold,track by_src,count 20,seconds 5; classtype:network-scan; sid:9000003; rev:1;)
alert http $HOME_NET any -> any any (msg:"curl Tool Detected"; flow:to_server,established; http.user_agent; content:"curl"; nocase; classtype:policy-violation; sid:9000004; rev:1;)
alert dns any any -> any any (msg:"Suspicious DNS Query"; dns.query; content:".onion"; endswith; nocase; classtype:policy-violation; sid:9000005; rev:1;)
